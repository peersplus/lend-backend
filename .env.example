PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/peersplus

# Comma-separated origins
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
# Optional single origin (kept for compatibility)
CORS_ORIGIN=http://localhost:8080

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=

# Storage
STORAGE_ROOT=./uploads
PUBLIC_API_URL=http://localhost:4000
PUBLIC_FRONTEND_URL=http://localhost:8080

# SMTP / Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PeersPlus <no-reply@peersplus.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_USER_NAME=

# OAuth Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth Microsoft
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=
OUTLOOK_OAUTH_TENANT_ID=common

# OAuth state signing
OAUTH_STATE_SECRET=change-me-in-production

# WhatsApp Cloud API
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_APP_SECRET=

# Signup alert emails
SIGNUP_ALERT_TO=peersplushr@gmail.com
SIGNUP_ALERT_CC=peersplushr@gmail.com

# Urgent matching
URGENT_MATCH_MIN_SCORE=2
URGENT_MATCH_MAX_RECIPIENTS=25
URGENT_MATCH_MAX_ITEMS=600
URGENT_REALERT_ENABLED=true
URGENT_REALERT_MINUTES=10
